# LORE config (copy to .env)

# Use public PyPI when installing deps (no Artifactory):
#   pip install -r requirements.txt -i https://pypi.org/simple
# Or: PIP_CONFIG_FILE=pip.conf pip install -r requirements.txt

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=your_project_id_here
ANTHROPIC_API_KEY=your_anthropic_key_here
WEBHOOK_SECRET=your_webhook_secret_here
PORT=8000
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# The API receives only the isolated gateway URL. Protegrity credentials belong
# in privacy_gateway/.env and must never be loaded by this process.
PROTEGRITY_PRIVACY_GATEWAY_URL=http://localhost:8180
PROTEGRITY_FAIL_CLOSED=true

# Next.js dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# GitHub + OpenAI-compatible AI (for the GitHub migration)
AI_BASE_URL=https://api.example.com/openai/v1
AI_API_KEY=your_openai_compatible_api_key_here
AI_MODEL=your_model_id_here
AI_FALLBACK_MODEL=your_fallback_model_id_here
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_user_or_org_here
GITHUB_MEMORY_REPOSITORY=lore-memory
GITHUB_MEMORY_BRANCH=main
